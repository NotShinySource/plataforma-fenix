rules_version = '2';

// ============================================================================
// Reglas de Firestore de la Plataforma Fénix.
//
// - Rol: viene del custom claim `rol` del token (lo fija el servidor al crear
//   la cuenta), nunca de un documento que el usuario pueda modificar.
// - Pertenencia a un elenco: el documento miembros_elenco/{elencoId}_{uid}
//   debe existir y estar activo. Su ID determinístico permite comprobarlo con
//   un solo get().
// - Lo que administra la Dirección (usuarios, elencos, membresías, clases,
//   asistencia, datos personales) se escribe solo desde el servidor, con
//   Server Actions que usan el Admin SDK. El Admin SDK no pasa por estas
//   reglas, así que aquí esas colecciones quedan en solo lectura o cerradas.
// - Las reglas no son filtros: una consulta solo se permite si sus propios
//   where() garantizan que todos los resultados cumplen la regla. Por eso
//   las consultas del navegador siempre filtran por elencoId o por el uid
//   de quien consulta.
// - Todo lo que no aparece aquí queda denegado.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Sesión

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado() && request.auth.token.rol == 'administrador';
    }

    function esPropio(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------ Elencos

    function membresia(elencoId) {
      return get(/databases/$(database)/documents/miembros_elenco/$(elencoId + '_' + request.auth.uid));
    }

    function esMiembro(elencoId) {
      return autenticado()
        && exists(/databases/$(database)/documents/miembros_elenco/$(elencoId + '_' + request.auth.uid))
        && membresia(elencoId).data.activo == true;
    }

    function esProfesorDelElenco(elencoId) {
      return esMiembro(elencoId)
        && request.auth.token.rol == 'profesor'
        && membresia(elencoId).data.rolEnElenco == 'profesor';
    }

    function esAlumnoDelElenco(elencoId) {
      return esMiembro(elencoId)
        && request.auth.token.rol == 'alumno'
        && membresia(elencoId).data.rolEnElenco == 'alumno';
    }

    // Un grupo archivado (activo == false) conserva su historial, pero no
    // admite material, avisos ni tareas nuevos. Los grupos antiguos sin el
    // campo cuentan como activos.
    function grupoActivo(elencoId) {
      let ruta = /databases/$(database)/documents/elencos/$(elencoId);
      return exists(ruta) && get(ruta).data.get('activo', true) == true;
    }

    function puedePublicarEn(elencoId) {
      return esProfesorDelElenco(elencoId) && grupoActivo(elencoId);
    }

    // Otra persona (no quien hace la solicitud) es alumno activo del elenco.
    function esAlumnoActivoDe(elencoId, usuarioId) {
      let ruta = /databases/$(database)/documents/miembros_elenco/$(elencoId + '_' + usuarioId);
      return usuarioId is string
        && exists(ruta)
        && get(ruta).data.activo == true
        && get(ruta).data.rolEnElenco == 'alumno';
    }

    // ------------------------------------------------------ Validaciones

    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    // Una fecha de creación debe ser la hora del servidor (serverTimestamp()).
    function esHoraDelServidor(valor) {
      return valor == request.time;
    }

    // ---------------------------------------------------------- Usuarios

    // Solo nombres, rol y estado de activación: los datos personales están
    // cifrados en datos_privados. Se puede leer un perfil conociendo su uid
    // (para mostrar el nombre de un compañero o del docente), pero listar a
    // todas las personas de la escuela queda reservado a la Dirección.
    match /usuarios/{uid} {
      allow get: if autenticado();
      allow list: if esAdmin();
      allow write: if false;
    }

    // ----------------------------------------------- Elencos y membresías

    match /elencos/{elencoId} {
      allow get: if esAdmin() || esMiembro(elencoId);
      allow list: if esAdmin();
      allow write: if false;
    }

    // Cada uno ve sus propias membresías; un docente ve las de sus elencos
    // (la lista del curso); la Dirección ve todas. El ID termina en el uid
    // del miembro, así que consultar "¿soy miembro de este elenco?" se
    // responde aunque el documento no exista (no existe = no es miembro).
    // Nombres, tipo y niveles de las escuelas: no hay datos personales. Las
    // escribe solo el servidor.
    match /escuelas/{escuelaId} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /miembros_elenco/{membresiaId} {
      allow get: if autenticado() && membresiaId.matches('.+_' + request.auth.uid);
      allow read: if esAdmin()
        || (autenticado() && resource.data.usuarioId == request.auth.uid)
        || esProfesorDelElenco(resource.data.elencoId);
      allow write: if false;
    }

    // ---------------------------------------------------- Material (RF-05)

    match /archivos/{archivoId} {
      allow read: if esAdmin() || esMiembro(resource.data.elencoId);

      allow create: if puedePublicarEn(request.resource.data.elencoId)
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'elencoId', 'profesorId', 'tipo', 'categoria', 'titulo',
          'nombreArchivo', 'urlStorage', 'tamanioBytes', 'fechaSubida'])
        && request.resource.data.tipo in ['pdf', 'mp3', 'wav']
        && textoValido(request.resource.data.titulo, 150)
        && textoValido(request.resource.data.categoria, 60)
        && textoValido(request.resource.data.nombreArchivo, 255)
        && request.resource.data.urlStorage is string
        && request.resource.data.tamanioBytes is int
        && esHoraDelServidor(request.resource.data.fechaSubida);

      // Lo elimina quien lo subió, mientras siga siendo docente del elenco.
      allow delete: if resource.data.profesorId == request.auth.uid
        && esProfesorDelElenco(resource.data.elencoId);
      allow update: if false;
    }

    // ------------------------------------------------- Asistencia (RF-09)

    // Se registra desde el servidor, dentro de una clase en curso. El alumno
    // ve la suya; el docente, la de sus elencos.
    match /asistencias/{asistenciaId} {
      allow read: if esAdmin()
        || (autenticado() && resource.data.alumnoId == request.auth.uid)
        || esProfesorDelElenco(resource.data.elencoId);
      allow write: if false;
    }

    // Observaciones del docente sobre un alumno en una clase (incidentes,
    // faltas). Uso interno: el alumno no las puede leer, por eso están fuera
    // del documento de asistencia, que sí puede leer.
    match /observaciones_asistencia/{asistenciaId} {
      allow read: if esAdmin() || esProfesorDelElenco(resource.data.elencoId);
      allow write: if false;
    }

    // ----------------------------------------------------- Avisos (RF-11)

    match /avisos/{avisoId} {
      allow read: if esAdmin() || esMiembro(resource.data.elencoId);

      allow create: if puedePublicarEn(request.resource.data.elencoId)
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'elencoId', 'profesorId', 'titulo', 'contenido', 'urgente', 'fechaPublicacion'])
        && textoValido(request.resource.data.titulo, 150)
        && textoValido(request.resource.data.contenido, 5000)
        && request.resource.data.urgente is bool
        && esHoraDelServidor(request.resource.data.fechaPublicacion);

      allow update, delete: if false;

      // Lectura de un aviso por un alumno. El ID del documento es el uid del
      // alumno: solo se escribe la propia, y solo de avisos de sus elencos.
      match /lecturas/{alumnoId} {
        allow read: if esAdmin() || esPropio(alumnoId);
        allow create, update: if esPropio(alumnoId)
          && esAlumnoDelElenco(get(/databases/$(database)/documents/avisos/$(avisoId)).data.elencoId)
          && request.resource.data.keys().hasOnly(['leido', 'fechaLectura'])
          && request.resource.data.leido == true
          && esHoraDelServidor(request.resource.data.fechaLectura);
        allow delete: if false;
      }
    }

    // ----------------------------------------------------- Tareas (RF-13)

    match /tareas/{tareaId} {
      // El alumno solo cambia su propio estado de "cumplida": agrega o quita
      // su uid de completadoPor y su propia fecha en completadoEn, sin tocar
      // ningún otro campo ni el estado de otro alumno.
      function soloCambiaSuPropioEstado() {
        let antes = resource.data.completadoPor.toSet();
        let despues = request.resource.data.completadoPor.toSet();
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completadoPor', 'completadoEn'])
          && despues.difference(antes).union(antes.difference(despues))
            .hasOnly([request.auth.uid])
          && request.resource.data.completadoEn.diff(resource.data.completadoEn)
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      // Una tarea va a todo el elenco (alumnoId == null) o a un solo alumno.
      // El alumno ve las del elenco completo y las suyas, nunca las
      // individuales de un compañero. Las consultas del alumno filtran por
      // elencoId y por alumnoId, para que esta regla se pueda comprobar.
      function esParaEsteAlumno() {
        return esAlumnoDelElenco(resource.data.elencoId)
          && (resource.data.alumnoId == null || resource.data.alumnoId == request.auth.uid);
      }

      // El docente solo edita el título y la fecha límite: el elenco, el
      // destinatario, el adjunto y el avance de los alumnos no cambian por
      // esta vía.
      function soloCambiaTituloYFecha() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['titulo', 'fechaLimite'])
          && textoValido(request.resource.data.titulo, 120);
      }

      allow read: if esAdmin()
        || esProfesorDelElenco(resource.data.elencoId)
        || esParaEsteAlumno();

      allow create: if puedePublicarEn(request.resource.data.elencoId)
        && request.resource.data.profesorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'titulo', 'elencoId', 'profesorId', 'alumnoId', 'fechaLimite', 'tipoAdjunto',
          'urlAdjunto', 'nombreAdjunto', 'completadoPor', 'completadoEn', 'fechaCreacion'])
        && request.resource.data.keys().hasAll(['alumnoId'])
        && (request.resource.data.alumnoId == null
          || esAlumnoActivoDe(request.resource.data.elencoId, request.resource.data.alumnoId))
        && textoValido(request.resource.data.titulo, 120)
        && request.resource.data.tipoAdjunto in ['Ninguno', 'PDF', 'Audio']
        && request.resource.data.completadoPor.size() == 0
        && request.resource.data.completadoEn.size() == 0
        && esHoraDelServidor(request.resource.data.fechaCreacion);

      allow update: if (resource.data.profesorId == request.auth.uid
          && esProfesorDelElenco(resource.data.elencoId)
          && soloCambiaTituloYFecha())
        || (esParaEsteAlumno() && soloCambiaSuPropioEstado());

      allow delete: if resource.data.profesorId == request.auth.uid
        && esProfesorDelElenco(resource.data.elencoId);
    }

    // ----------------------------------------------------------- Clases

    // Semestres: solo fechas de inicio y fin, sin datos de personas.
    match /semestres/{semestreId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // Horarios y sesiones: los ve quien pertenece al elenco. Se escriben
    // desde el servidor, que usa su propia hora para el inicio y el término.
    match /clases/{claseId} {
      allow read: if esAdmin() || esMiembro(resource.data.elencoId);
      allow write: if false;
    }

    match /sesiones_clase/{sesionId} {
      allow read: if esAdmin() || esMiembro(resource.data.elencoId);
      allow write: if false;
    }

    // ------------------------------------------- Solo para el servidor

    // Contenido de la Landing: lo escribe el Administrador mediante Server
    // Actions y lo lee el servidor al armar la página pública.
    match /contenido_landing/{documento} {
      allow read, write: if false;
    }

    match /actuaciones_landing/{actuacionId} {
      allow read, write: if false;
    }

    // Datos personales cifrados (RUT, correos, fecha de nacimiento) y el
    // contador de solicitudes de acceso. Ni el propio usuario puede leerlos.
    match /datos_privados/{uid} {
      allow read, write: if false;
    }

    match /solicitudes_acceso/{uid} {
      allow read, write: if false;
    }
  }
}
