rules_version = '2';

// ============================================================================
// Reglas de Storage de la Plataforma Fénix.
//
// Las imágenes públicas de la Landing viven en landing/{portada|actuaciones}/.
// Los archivos de un elenco viven en elencos/{elencoId}/{carpeta}/{archivo}:
//   - pdf, mp3, wav: material de estudio;
//   - tareas: adjunto de una tarea (PDF o audio).
// Pertenencia y rol se comprueban contra Firestore (miembros_elenco), igual
// que en firestore.rules. Tamaño y formato se validan aquí, en el servidor,
// aunque el formulario ya los revise antes de subir.
//
// Nota: getDownloadURL() entrega un enlace con token que no pasa por estas
// reglas. Esos enlaces solo se guardan en documentos que Firestore deja leer
// a los miembros del elenco.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado() && request.auth.token.rol == 'administrador';
    }

    function rutaMembresia(elencoId) {
      return /databases/(default)/documents/miembros_elenco/$(elencoId + '_' + request.auth.uid);
    }

    function esMiembro(elencoId) {
      return autenticado()
        && firestore.exists(rutaMembresia(elencoId))
        && firestore.get(rutaMembresia(elencoId)).data.activo == true;
    }

    function esProfesorDelElenco(elencoId) {
      return esMiembro(elencoId)
        && request.auth.token.rol == 'profesor'
        && firestore.get(rutaMembresia(elencoId)).data.rolEnElenco == 'profesor';
    }

    function megabytes(cantidad) {
      return cantidad * 1024 * 1024;
    }

    function esPdf() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size <= megabytes(25);
    }

    function esMp3() {
      return request.resource.contentType == 'audio/mpeg'
        && request.resource.size <= megabytes(50);
    }

    function esWav() {
      return request.resource.contentType in ['audio/wav', 'audio/x-wav', 'audio/wave', 'audio/vnd.wave']
        && request.resource.size <= megabytes(50);
    }

    function formatoPermitido(carpeta) {
      return (carpeta == 'pdf' && esPdf())
        || (carpeta == 'mp3' && esMp3())
        || (carpeta == 'wav' && esWav())
        || (carpeta == 'tareas' && (esPdf() || esMp3() || esWav()));
    }

    match /elencos/{elencoId}/{carpeta}/{archivo} {
      allow read: if esAdmin() || esMiembro(elencoId);
      // Solo archivos nuevos: un archivo subido no se reemplaza. Subir sobre
      // una ruta existente también cuenta como "create", por eso se exige
      // que no haya un objeto previo (resource == null).
      allow create: if resource == null
        && esProfesorDelElenco(elencoId)
        && formatoPermitido(carpeta);
      allow delete: if esProfesorDelElenco(elencoId);
      allow update: if false;
    }

    // Imágenes de la Landing: públicas, porque las ve cualquier visitante.
    // Solo el Administrador sube (JPG, PNG o WebP de hasta 5 MB) o borra.
    match /landing/{carpeta}/{archivo} {
      allow read: if true;
      allow create: if resource == null
        && esAdmin()
        && carpeta in ['portada', 'actuaciones']
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= megabytes(5);
      allow delete: if esAdmin();
      allow update: if false;
    }

    // Cualquier otra ruta queda cerrada.
  }
}
